generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Connection URL configured in prisma.config.ts (Prisma 7 pattern)
  // Docker PostgreSQL — no directUrl needed
}


model School {
  id Int @id @default(autoincrement())
  name String @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  academicYears AcademicYear[]
  admins  Admin[] 
  students Student[]
  studentAcademicYears StudentAcademicYear[]
  teachers Teacher[]
  parents Parent[]
  grades Grade[]
  classes Class[]
  subjects Subject[]
  lessons Lesson[]
  events Event[]
  announcements Announcement[]
  messages Message[]
  attendances Attendance[]
  exams Exam[]
  assignments Assignment[]
  schoolSettings SchoolSettings[]
  dayExceptions SchoolDayException[]
  results Result[]

  // Exam workflow relations
  questions   Question[]
  submissions Submission[]
  answers     Answer[]
}


model Admin{
  id String @id
  username String
  schoolId Int
  school School @relation(fields: [schoolId], references: [id])
  @@unique([schoolId, username])

  @@index([schoolId])
}


model SchoolSettings {
  id Int @id @default(autoincrement())
  schoolId Int @unique
  school School @relation(fields: [schoolId], references: [id])

  workDayStart DateTime @db.Time
  workDayEnd DateTime @db.Time

  lessonDuration Int
  lessonsPerDay Int
  workingDays Json @default("[\"SATURDAY\",\"SUNDAY\",\"MONDAY\",\"TUESDAY\",\"WEDNESDAY\",\"THURSDAY\"]")

  updatedAt DateTime @updatedAt

  @@index([schoolId])
}

model SchoolDayException {
  id Int @id @default(autoincrement())
  schoolId Int
  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  date DateTime @db.Date
  type SchoolDayExceptionType
  name String?
  notes String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, date])
  @@index([schoolId])
  @@index([date])
}

model AcademicYear {
  id Int @id @default(autoincrement())
  schoolId Int
  school School @relation(fields: [schoolId], references: [id])
  name String 
  startDate DateTime @db.Date
  endDate DateTime @db.Date
  isCurrent Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lessons Lesson[]
  exams Exam[]
  assignments Assignment[]
  results Result[]
  attendances Attendance[]
  events Event[]
  announcements Announcement[]
  messages Message[]
  studentAcademicYears StudentAcademicYear[]

 @@unique([schoolId, name])
}

model Student{  
  id String @id
  schoolId Int
  school School @relation(fields: [schoolId], references: [id])
  username String
  @@unique([schoolId, username])
  name String
  email String?
  @@unique([schoolId, email])
  phone String?
  @@unique([schoolId, phone])
  address String
  img String?
  bloodType String
  sex UserSex
  status StudentStatus @default(ACTIVE)
  repeatCount Int @default(0)
  createdAt DateTime @default(now())
  parentId String?
  parent Parent? @relation(fields:[parentId], references: [id])
  classId Int
  class Class @relation(fields:[classId], references: [id])
  gradeId Int
  grade Grade @relation(fields:[gradeId], references: [id])
  attendances Attendance[]
  results Result[]
  messages Message[]
  academicYears StudentAcademicYear[]
  birthday DateTime
  submissions Submission[]

  @@index([schoolId])
}
model Teacher{  
  id String @id
  schoolId Int
  school School @relation(fields: [schoolId], references: [id])
  username String
  @@unique([schoolId, username])
  name String
  email String?
  @@unique([schoolId, email])
  phone String?
  @@unique([schoolId, phone])
  address String
  img String?
  bloodType String
  sex UserSex
  createdAt DateTime @default(now())
  subjects Subject[]
  lessons Lesson[]
  classes Class[] @relation("TeacherClasses")
  supervisedClasses Class[] @relation("ClassSupervisor")
  attendances Attendance[]
  messages Message[]
  birthday DateTime

  @@index([schoolId])
}
model Parent{  
  id String @id
  schoolId Int
  school School @relation(fields: [schoolId], references: [id])
  username String
  @@unique([schoolId, username])
  name String
  email String?
  @@unique([schoolId, email])
  phone String
  @@unique([schoolId, phone])
  address String
  createdAt DateTime @default(now())
  students Student[]
  messages Message[]

  @@index([schoolId])
}
model Grade{
  id Int @id @default(autoincrement())
  schoolId Int
  school School @relation(fields: [schoolId], references: [id])
  level Int
  @@unique([schoolId, level])
  students Student[]
  classes Class[]
  subjects Subject[]
  studentAcademicYears StudentAcademicYear[]

  @@index([schoolId])
}
model Class{
  id Int @id @default(autoincrement())
  schoolId Int
  school School @relation(fields: [schoolId], references: [id])
  name String
  @@unique([schoolId, name])
  capacity Int
  supervisorId String?
  supervisor Teacher? @relation("ClassSupervisor", fields: [supervisorId], references: [id])
  teachers Teacher[] @relation("TeacherClasses")
  lessons Lesson[]
  students Student[]
  gradeId Int
  grade Grade @relation(fields: [gradeId], references: [id])
  events Event[]
  announcements Announcement[]
  messages Message[]
  exams Exam[]
  assignments Assignment[]
  studentAcademicYears StudentAcademicYear[]

  @@index([schoolId])
}

model StudentAcademicYear {
  id Int @id @default(autoincrement())

  studentId String
  student Student @relation(fields: [studentId], references: [id])

  schoolId Int
  school School @relation(fields: [schoolId], references: [id])

  academicYearId Int
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])

  gradeId Int
  grade Grade @relation(fields: [gradeId], references: [id])

  classId Int?
  class Class? @relation(fields: [classId], references: [id])

  performanceStatus PassFailStatus?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, studentId, academicYearId])
  @@index([academicYearId])
  @@index([gradeId])
  @@index([classId])
  @@index([schoolId])
}
model Subject{
  id Int @id @default(autoincrement())
  schoolId Int
  school School @relation(fields: [schoolId], references: [id])
  name String
  @@unique([schoolId, name])
  gradeId Int
  grade Grade @relation(fields: [gradeId], references: [id])
  teachers Teacher[]
  lessons Lesson[]
  exams Exam[]
  assignments Assignment[]

  @@index([schoolId])
}
model Lesson{
  id Int @id @default(autoincrement())
  schoolId Int
  school School @relation(fields: [schoolId], references: [id])
  name String
  day Day
  startTime DateTime
  endTime DateTime
  subjectId Int
  subject Subject @relation(fields: [subjectId], references: [id])
  classId Int
  class Class @relation(fields: [classId], references: [id])
  teacherId String
  teacher Teacher @relation(fields: [teacherId], references: [id])
  academicYearId Int
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])
  exams Exam[]
  assignments Assignment[]

  @@index([schoolId])
}
model Exam{
  id Int @id @default(autoincrement())
  schoolId Int
  school School @relation(fields: [schoolId], references: [id])
  title String
  startTime DateTime
  endTime DateTime

  classId Int?
  class Class? @relation(fields: [classId], references: [id])
  subjectId Int?
  subject Subject? @relation(fields: [subjectId], references: [id])

  lessonId Int
  lesson Lesson @relation(fields: [lessonId], references: [id])

  academicYearId Int
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])

  results Result[]

  // Feature toggles — all per-exam configurable
  enableTimer      Boolean @default(true)
  duration         Int?                    // minutes — required if enableTimer = true
  enableNavigation Boolean @default(true)  // allow prev page navigation
  enableAutoSave   Boolean @default(true)  // auto-save answers
  autoSaveInterval Int     @default(30)    // seconds between auto-saves
  enableAutoSubmit Boolean @default(true)  // cron auto-submit backstop
  questionsPerPage Int     @default(1)     // server-side pagination size

  // Exam workflow relations
  questions   Question[]
  submissions Submission[]

  @@index([schoolId])
}
model Assignment{
  id Int @id @default(autoincrement())
  schoolId Int
  school School @relation(fields: [schoolId], references: [id])
  title String
  startDate DateTime
  endDate DateTime

  classId Int?
  class Class? @relation(fields: [classId], references: [id])
  subjectId Int?
  subject Subject? @relation(fields: [subjectId], references: [id])

  lessonId Int
  lesson Lesson @relation(fields: [lessonId], references: [id])

  academicYearId Int
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])

  results Result[]

  @@index([schoolId])
}
model Result{
  id Int @id @default(autoincrement())
  schoolId Int
  school School @relation(fields: [schoolId], references: [id])
  score Int

  examId Int?
  exam Exam? @relation(fields: [examId], references: [id])
  assignmentId Int?
  assignment Assignment? @relation(fields: [assignmentId], references: [id])

  studentId String
  student Student @relation(fields: [studentId], references: [id])

  academicYearId Int
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])

  @@index([schoolId])
}
model Attendance{
  id Int @id @default(autoincrement())
  schoolId Int
  school School @relation(fields: [schoolId], references: [id])
  date DateTime
  present Boolean

  academicYearId Int
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])

  studentId String?
  student Student? @relation(fields: [studentId], references: [id])

  teacherId String?
  teacher Teacher? @relation(fields: [teacherId], references: [id])

  @@unique([studentId, academicYearId, date])
  @@unique([teacherId, academicYearId, date])
  @@index([academicYearId])
  @@index([date])
  @@index([studentId])
  @@index([teacherId])
  @@index([schoolId])
}
model Event{
  id Int @id @default(autoincrement())
  schoolId Int
  school School @relation(fields: [schoolId], references: [id])
  title String
  description String
  startDate DateTime
  endDate DateTime
  academicYearId Int
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])
  classes Class[]

  @@index([schoolId])
}
model Announcement{
  id Int @id @default(autoincrement())
  schoolId Int
  school School @relation(fields: [schoolId], references: [id])
  title String
  description String
  date DateTime
  academicYearId Int
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])
  classes Class[]

  @@index([schoolId])
}

model Message {
  id Int @id @default(autoincrement())
  schoolId Int
  school School @relation(fields: [schoolId], references: [id])
  title String
  description String
  date DateTime @default(now())
  academicYearId Int
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])
  students Student[]
  parents Parent[]
  teachers Teacher[]
  classes Class[]

  @@index([schoolId])
}


// ===== EXAM WORKFLOW MODELS =====

model Question {
  id            Int          @id @default(autoincrement())
  schoolId      Int
  school        School       @relation(fields: [schoolId], references: [id])
  examId        Int
  exam          Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  text          String
  type          QuestionType
  points        Int          @default(1)
  order         Int
  options       Json?        // MCQ only: string[]
  correctAnswer String[]     // T/F and MCQ — array supports multiple correct answers
  allowMultiple Boolean      @default(false)
  answers       Answer[]

  @@index([schoolId])
  @@index([examId])
}

model Submission {
  id               Int              @id @default(autoincrement())
  schoolId         Int
  school           School           @relation(fields: [schoolId], references: [id])
  examId           Int
  exam             Exam             @relation(fields: [examId], references: [id])
  studentId        String
  student          Student          @relation(fields: [studentId], references: [id])
  status           SubmissionStatus @default(IN_PROGRESS)
  currentPage      Int              @default(1)
  startedAt        DateTime         @default(now())
  submittedAt      DateTime?
  autoSubmitted    Boolean          @default(false)
  lastSyncedAt     DateTime?        // Anti-cheat: updated on every saveAnswer
  totalScore       Float?
  extraTime        Int?             // Additional minutes granted by teacher
  extendedBy       String?          // Teacher Clerk ID who granted extension
  extendedAt       DateTime?
  disconnectedAt   DateTime?        // Logged on reconnection for audit
  reconnectedAt    DateTime?
  totalOfflineTime Int?             // Seconds offline — computed server-side
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  answers          Answer[]

  @@unique([examId, studentId])   // One submission per student per exam
  @@index([schoolId])
  @@index([examId])
  @@index([studentId])
}

model Answer {
  id           Int        @id @default(autoincrement())
  schoolId     Int
  school       School     @relation(fields: [schoolId], references: [id])
  submissionId Int
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  questionId   Int
  question     Question   @relation(fields: [questionId], references: [id])
  textAnswer   String?    // T/F, MCQ (comma-separated for multi-select), TEXT
  fileUrl      String?    // FILE — relative path or URL
  isDraft      Boolean    @default(true)   // false after submitExam finalizes it
  savedAt      DateTime   @default(now())  // ALWAYS set by server — never accepted from client
  score        Float?     // null until graded

  @@unique([submissionId, questionId])
  @@index([schoolId])
  @@index([submissionId])
}

// ===== EXAM WORKFLOW ENUMS =====

enum QuestionType {
  TRUE_FALSE
  MCQ
  TEXT
  FILE
}

enum SubmissionStatus {
  IN_PROGRESS
  SUBMITTED
  GRADED
}

enum UserSex {
  MALE
  FEMALE
}

enum Day{
  SATURDAY
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
}

enum StudentStatus {
  ACTIVE
  REPEATED
  GRADUATED
  LEFT
}

enum PassFailStatus {
  PASS
  FAIL
}

enum SchoolDayExceptionType {
  HOLIDAY
  OFF_DAY
  WORKING_OVERRIDE
}
