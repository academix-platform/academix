generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Connection URL configured in prisma.config.ts (Prisma 7 pattern)
  // Docker PostgreSQL — no directUrl needed
}

model School {
  id Int @id @default(autoincrement())
  name String @unique
  contactEmail String?
  contactPhone String?
  website String?
  country String?
  city String?
  address String?
  registrationNumber String?
  status SchoolStatus @default(PENDING)
  pauseReason String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  academicYears         AcademicYear[]
  admins                Admin[]
  students              Student[]
  studentAcademicYears  StudentAcademicYear[]
  teachers              Teacher[]
  parents               Parent[]
  grades                Grade[]
  classes               Class[]
  subjects              Subject[]
  lessons               Lesson[]
  events                Event[]
  announcements         Announcement[]
  messages              Message[]
  attendances           Attendance[]
  exams                 Exam[]
  assignments           Assignment[]
  assignmentSubmissions AssignmentSubmission[]
  studyMaterials        StudyMaterial[]
  schoolSettings        SchoolSettings[]
  schoolDayExceptions   SchoolDayException[]
  results               Result[]
  aiEvaluations         AiEvaluation[]

  // Exam workflow relations
  questions   Question[]
  submissions Submission[]
  answers     Answer[]

  subjectPageSettings SubjectPageSettings[]
}

model Admin {
  id       String @id
  username String
  schoolId Int
  school   School @relation(fields: [schoolId], references: [id])

  @@unique([schoolId, username])
  @@index([schoolId])
}

model SchoolSettings {
  id       Int      @id @default(autoincrement())
  schoolId Int      @unique
  school   School   @relation(fields: [schoolId], references: [id])

  workDayStart DateTime @db.Time
  workDayEnd   DateTime @db.Time

  lessonDuration Int
  lessonsPerDay  Int
  workingDays   String[] @default([])

  updatedAt DateTime @updatedAt

  @@index([schoolId])
}

model SchoolDayException {
  id        Int                    @id @default(autoincrement())
  schoolId  Int
  school    School                 @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  date      DateTime               @db.Date
  type      SchoolDayExceptionType
  name      String?
  notes     String?
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  @@unique([schoolId, date])
  @@index([schoolId])
  @@index([date])
}

model AcademicYear {
  id        Int      @id @default(autoincrement())
  schoolId  Int
  school    School   @relation(fields: [schoolId], references: [id])
  name      String
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  isCurrent Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lessons               Lesson[]
  exams                 Exam[]
  assignments           Assignment[]
  studyMaterials        StudyMaterial[]
  results               Result[]
  attendances           Attendance[]
  events                Event[]
  announcements         Announcement[]
  messages              Message[]
  studentAcademicYears  StudentAcademicYear[]
  submissions           Submission[] // exam submissions
  assignmentSubmissions AssignmentSubmission[] // assignment submissions

  @@unique([schoolId, name])
}

model Student {
  id                    String                 @id
  schoolId              Int
  school                School                 @relation(fields: [schoolId], references: [id])
  username              String
  name                  String
  email                 String?
  phone                 String?
  address               String
  img                   String?
  bloodType             String
  sex                   UserSex
  status                StudentStatus          @default(ACTIVE)
  repeatCount           Int                    @default(0)
  createdAt             DateTime               @default(now())
  parentId              String?
  parent                Parent?                @relation(fields: [parentId], references: [id])
  classId               Int
  class                 Class                  @relation(fields: [classId], references: [id])
  gradeId               Int
  grade                 Grade                  @relation(fields: [gradeId], references: [id])
  attendances           Attendance[]
  results               Result[]
  messages              Message[]
  academicYears         StudentAcademicYear[]
  birthday              DateTime
  submissions           Submission[] // exam submissions
  assignmentSubmissions AssignmentSubmission[] // assignment submissions

  @@unique([schoolId, username])
  @@unique([schoolId, email])
  @@unique([schoolId, phone])
  @@index([schoolId])
}

model Teacher {
  id                  String                @id
  schoolId            Int
  school              School                @relation(fields: [schoolId], references: [id])
  username            String
  name                String
  email               String?
  phone               String?
  address             String
  img                 String?
  bloodType           String
  sex                 UserSex
  createdAt           DateTime              @default(now())
  subjects            Subject[]
  lessons             Lesson[]
  classes             Class[]               @relation("TeacherClasses")
  supervisedClasses   Class[]               @relation("ClassSupervisor")
  attendances         Attendance[]
  messages            Message[]
  studyMaterials      StudyMaterial[]
  birthday            DateTime
  exams               Exam[]
  assignments         Assignment[]
  subjectPageSettings SubjectPageSettings[]

  @@unique([schoolId, username])
  @@unique([schoolId, email])
  @@unique([schoolId, phone])
  @@index([schoolId])
}

model Parent {
  id        String    @id
  schoolId  Int
  school    School    @relation(fields: [schoolId], references: [id])
  username  String
  name      String
  email     String?
  phone     String
  address   String
  createdAt DateTime  @default(now())
  students  Student[]
  messages  Message[]

  @@unique([schoolId, username])
  @@unique([schoolId, email])
  @@unique([schoolId, phone])
  @@index([schoolId])
}

model Grade {
  id                   Int                   @id @default(autoincrement())
  schoolId             Int
  school               School                @relation(fields: [schoolId], references: [id])
  level                Int
  students             Student[]
  classes              Class[]
  subjects             Subject[]
  studentAcademicYears StudentAcademicYear[]

  @@unique([schoolId, level])
  @@index([schoolId])
}

model Class {
  id                   Int                   @id @default(autoincrement())
  schoolId             Int
  school               School                @relation(fields: [schoolId], references: [id])
  name                 String
  capacity             Int
  supervisorId         String?
  supervisor           Teacher?              @relation("ClassSupervisor", fields: [supervisorId], references: [id])
  teachers             Teacher[]             @relation("TeacherClasses")
  lessons              Lesson[]
  students             Student[]
  gradeId              Int
  grade                Grade                 @relation(fields: [gradeId], references: [id])
  events               Event[]
  announcements        Announcement[]
  messages             Message[]
  exams                Exam[]
  assignments          Assignment[]
  studentAcademicYears StudentAcademicYear[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

model StudentAcademicYear {
  id Int @id @default(autoincrement())

  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  schoolId Int
  school   School @relation(fields: [schoolId], references: [id])

  academicYearId Int
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])

  gradeId Int
  grade   Grade @relation(fields: [gradeId], references: [id])

  classId Int?
  class   Class? @relation(fields: [classId], references: [id])

  performanceStatus PassFailStatus?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, studentId, academicYearId])
  @@index([academicYearId])
  @@index([gradeId])
  @@index([classId])
  @@index([schoolId])
}

model Subject {
  id             Int                   @id @default(autoincrement())
  schoolId       Int
  school         School                @relation(fields: [schoolId], references: [id])
  name           String
  gradeId        Int
  grade          Grade                 @relation(fields: [gradeId], references: [id])
  teachers       Teacher[]
  lessons        Lesson[]
  exams          Exam[]
  assignments    Assignment[]
  studyMaterials StudyMaterial[]
  pageSettings   SubjectPageSettings[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

model Lesson {
  id             Int          @id @default(autoincrement())
  schoolId       Int
  school         School       @relation(fields: [schoolId], references: [id])
  name           String
  day            Day
  startTime      DateTime
  endTime        DateTime
  subjectId      Int
  subject        Subject      @relation(fields: [subjectId], references: [id])
  classId        Int
  class          Class        @relation(fields: [classId], references: [id])
  teacherId      String
  teacher        Teacher      @relation(fields: [teacherId], references: [id])
  academicYearId Int
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  exams          Exam[]
  assignments    Assignment[]

  @@index([schoolId])
}

model Exam {
  id        Int      @id @default(autoincrement())
  schoolId  Int
  school    School   @relation(fields: [schoolId], references: [id])
  title     String
  startTime DateTime
  endTime   DateTime

  classId   Int?
  class     Class?   @relation(fields: [classId], references: [id])
  subjectId Int?
  subject   Subject? @relation(fields: [subjectId], references: [id])

  teacherId String?
  teacher   Teacher? @relation(fields: [teacherId], references: [id])

  lessonId Int?
  lesson   Lesson? @relation(fields: [lessonId], references: [id])

  academicYearId Int
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])

  results Result[]

  // Feature toggles
  enableTimer      Boolean @default(true)
  duration         Int?
  enableNavigation Boolean @default(true)
  enableAutoSave   Boolean @default(true)
  autoSaveInterval Int     @default(30)
  enableAutoSubmit Boolean @default(true)
  questionsPerPage Int     @default(1)

  // Exam workflow relations
  questions   Question[]
  submissions Submission[]

  @@index([schoolId])
  @@index([teacherId])
}

model Assignment {
  id                  Int      @id @default(autoincrement())
  schoolId            Int
  school              School   @relation(fields: [schoolId], references: [id])
  title               String
  description         String?
  rubric              String?
  startDate           DateTime
  endDate             DateTime
  fileUrl             String?
  fileName            String?
  maxScore            Float    @default(10)
  allowLateSubmission Boolean  @default(false) // ✅ أضف هذا السطر

  classId   Int?
  class     Class?   @relation(fields: [classId], references: [id])
  subjectId Int?
  subject   Subject? @relation(fields: [subjectId], references: [id])

  teacherId String?
  teacher   Teacher? @relation(fields: [teacherId], references: [id])

  lessonId Int?
  lesson   Lesson? @relation(fields: [lessonId], references: [id])

  academicYearId Int
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])

  results               Result[]
  assignmentSubmissions AssignmentSubmission[]

  @@index([schoolId])
  @@index([teacherId])
}

// Assignment file submission (from stash)
model AssignmentSubmission {
  id              Int     @id @default(autoincrement())
  fileUrl         String
  fileName        String
  fileType        String
  note            String?
  teacherFeedback String?
  score           Float?
  gradePublished  Boolean   @default(false)
  gradedAt        DateTime?
  gradedBy        String?
  aiEvaluation    AiEvaluation?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignmentId Int
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  schoolId Int
  school   School @relation(fields: [schoolId], references: [id])

  academicYearId Int
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])

  @@unique([assignmentId, studentId])
  @@index([schoolId])
  @@index([assignmentId])
  @@index([studentId])
}

model StudyMaterial {
  id       Int    @id @default(autoincrement())
  schoolId Int
  school   School @relation(fields: [schoolId], references: [id])

  title       String
  description String?
  fileUrl     String
  fileName    String
  fileType    String

  subjectId Int
  subject   Subject @relation(fields: [subjectId], references: [id])

  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id])

  academicYearId Int
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])

  createdAt DateTime @default(now())

  @@index([schoolId])
  @@index([subjectId])
  @@index([teacherId])
}

model Result {
  id       Int    @id @default(autoincrement())
  schoolId Int
  school   School @relation(fields: [schoolId], references: [id])
  score    Int

  examId       Int?
  exam         Exam?       @relation(fields: [examId], references: [id])
  assignmentId Int?
  assignment   Assignment? @relation(fields: [assignmentId], references: [id])

  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  academicYearId Int
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])

  @@index([schoolId])
}

model Attendance {
  id       Int      @id @default(autoincrement())
  schoolId Int
  school   School   @relation(fields: [schoolId], references: [id])
  date     DateTime
  present  Boolean

  academicYearId Int
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])

  studentId String?
  student   Student? @relation(fields: [studentId], references: [id])

  teacherId String?
  teacher   Teacher? @relation(fields: [teacherId], references: [id])

  @@unique([studentId, academicYearId, date])
  @@unique([teacherId, academicYearId, date])
  @@index([academicYearId])
  @@index([date])
  @@index([studentId])
  @@index([teacherId])
  @@index([schoolId])
}

model Event {
  id             Int          @id @default(autoincrement())
  schoolId       Int
  school         School       @relation(fields: [schoolId], references: [id])
  title          String
  description    String
  startDate      DateTime
  endDate        DateTime
  academicYearId Int
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  classes        Class[]

  @@index([schoolId])
}

model Announcement {
  id             Int          @id @default(autoincrement())
  schoolId       Int
  school         School       @relation(fields: [schoolId], references: [id])
  title          String
  description    String
  date           DateTime
  academicYearId Int
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  classes        Class[]

  @@index([schoolId])
}

model Message {
  id             Int          @id @default(autoincrement())
  schoolId       Int
  school         School       @relation(fields: [schoolId], references: [id])
  title          String
  description    String
  date           DateTime     @default(now())
  academicYearId Int
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  students       Student[]
  parents        Parent[]
  teachers       Teacher[]
  classes        Class[]

  @@index([schoolId])
}

// ===== SUBJECT PAGE SETTINGS =====

model SubjectPageSettings {
  id       Int    @id @default(autoincrement())
  schoolId Int
  school   School @relation(fields: [schoolId], references: [id])

  subjectId Int
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id])

  // Welcome announcement shown at top of page for students
  announcement String?

  // Short course description
  description String?

  // Banner image (Cloudinary URL)
  bannerImage String?

  // Banner height: sm | md | lg
  bannerHeight String @default("md")

  // Order of sections: JSON array e.g. ["assignments","lessons","materials"]
  sectionsOrder Json @default("[\"assignments\",\"lessons\",\"materials\"]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([subjectId, teacherId])
  @@index([schoolId])
  @@index([subjectId])
  @@index([teacherId])
}

// ===== EXAM WORKFLOW MODELS =====

model Question {
  id            Int          @id @default(autoincrement())
  schoolId      Int
  school        School       @relation(fields: [schoolId], references: [id])
  examId        Int
  exam          Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  text          String
  type          QuestionType
  points        Int          @default(1)
  order         Int
  options       Json?
  correctAnswer String[]
  allowMultiple Boolean      @default(false)
  textAnswer    String?      // Optional model answer for TEXT questions
  answers       Answer[]

  @@index([schoolId])
  @@index([examId])
}

model Submission {
  id               Int              @id @default(autoincrement())
  schoolId         Int
  school           School           @relation(fields: [schoolId], references: [id])
  examId           Int
  exam             Exam             @relation(fields: [examId], references: [id])
  studentId        String
  student          Student          @relation(fields: [studentId], references: [id])
  status           SubmissionStatus @default(IN_PROGRESS)
  currentPage      Int              @default(1)
  startedAt        DateTime         @default(now())
  submittedAt      DateTime?
  autoSubmitted    Boolean          @default(false)
  lastSyncedAt     DateTime?
  totalScore       Float?
  gradePublished   Boolean          @default(false)
  extraTime        Int?
  extendedBy       String?
  extendedAt       DateTime?
  disconnectedAt   DateTime?
  reconnectedAt    DateTime?
  totalOfflineTime Int?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  answers          Answer[]
  academicYear     AcademicYear?    @relation(fields: [academicYearId], references: [id])
  academicYearId   Int?

  @@unique([examId, studentId])
  @@index([schoolId])
  @@index([examId])
  @@index([studentId])
}

model Answer {
  id               Int        @id @default(autoincrement())
  schoolId         Int
  school           School     @relation(fields: [schoolId], references: [id])
  submissionId     Int
  submission       Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  questionId       Int
  question         Question   @relation(fields: [questionId], references: [id])
  textAnswer       String?    // T/F, MCQ (comma-separated for multi-select), TEXT
  fileUrl          String?    // FILE — Cloudinary secure_url
  isDraft          Boolean    @default(true)   // false after submitExam finalizes it
  savedAt          DateTime   @default(now())  // ALWAYS set by server — never accepted from client
  score            Float?     // null until graded
  isOverridden     Boolean    @default(false)
  filePublicId     String?    // Cloudinary public_id for deletion
  fileOriginalName String?    // Student's original filename
  fileMimeType     String?    // MIME type from Cloudinary
  fileSizeBytes    Int?       // File size in bytes
  aiEvaluation     AiEvaluation?

  @@unique([submissionId, questionId])
  @@index([schoolId])
  @@index([submissionId])
}

model AiEvaluation {
  id Int @id @default(autoincrement())

  schoolId Int
  school   School @relation(fields: [schoolId], references: [id])

  answerId Int?    @unique
  answer   Answer? @relation(fields: [answerId], references: [id], onDelete: Cascade)

  assignmentSubmissionId Int?                  @unique
  assignmentSubmission   AssignmentSubmission? @relation(fields: [assignmentSubmissionId], references: [id], onDelete: Cascade)

  provider String @default("gemini")
  model    String
  status   AiEvaluationStatus @default(SUGGESTED)

  score       Float?
  maxScore    Float
  feedback    String?
  strengths   Json   @default("[]")
  weaknesses  Json   @default("[]")
  needsReview Boolean @default(true)
  error       String?

  approvedScore    Float?
  approvedFeedback String?
  approvedBy       String?
  approvedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@index([answerId])
  @@index([assignmentSubmissionId])
}

// ===== ENUMS =====

enum QuestionType {
  TRUE_FALSE
  MCQ
  TEXT
  FILE
}

enum SubmissionStatus {
  IN_PROGRESS
  SUBMITTED
  GRADED
}

enum AiEvaluationStatus {
  SUGGESTED
  APPROVED
  FAILED
}

enum UserSex {
  MALE
  FEMALE
}

enum Day {
  SATURDAY
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
}

enum StudentStatus {
  ACTIVE
  REPEATED
  GRADUATED
  LEFT
}

enum PassFailStatus {
  PASS
  FAIL
}

enum SchoolStatus {
  PENDING
  ACTIVE
  PAUSED
}

enum SchoolDayExceptionType {
  HOLIDAY
  OFF_DAY
  WORKING_OVERRIDE
}
